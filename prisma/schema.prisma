generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PARENT
  HOMEROOM
  TEACHER
  MUDIR
  ADMIN
}

enum EducationLevel {
  SD
  SMP
  SMA
}

enum AdmissionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum UserStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// PRESENT = Hadir, ABSENT = Alpa, LATE = Terlambat, EXCUSED = Izin, SICK = Sakit.
enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  SICK
}

enum Semester {
  GANJIL
  GENAP
}

// Alur rapor: wali kelas menyusun (DRAFT), mengirim ke administrasi (SUBMITTED),
// administrasi meng-ACC (APPROVED) atau mengembalikan (REJECTED), lalu terbit (PUBLISHED).
enum ReportCardStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
}

// Jenis kelompok penilaian pada rapor: nilai mata pelajaran atau penilaian sikap.
enum AssessmentGroupKind {
  COURSE_SCORE
  BEHAVIOR
}

// Berkas syarat pendaftaran santri baru.
enum AdmissionDocumentKind {
  FAMILY_CARD
  BIRTH_CERTIFICATE
  PREVIOUS_REPORT
  PHOTO
  PAYMENT_PROOF
}

enum NotificationType {
  ADMISSION
  REPORT
  SCHEDULE
  SYSTEM
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  phone        String?
  passwordHash String
  // Postgres enum arrays would need a GIN index to be useful; dataset is dummy-scale, so skip it.
  roles        UserRole[]
  status       UserStatus   @default(PENDING)
  verifiedAt   DateTime?
  verifiedById String?
  children     StudentProfile[] @relation("ParentChildren")
  submittedAdmissions Admission[] @relation("AdmissionSubmitter")
  sessions     Session[]
  courses      Course[]     @relation("CourseCreator")
  teachingCourses Course[]  @relation("CourseTeacher")
  reportCards  ReportCard[] @relation("ReportCardCreator")
  staffAttendances StaffAttendance[] @relation("StaffAttendanceTeacher")
  recordedStaffAttendances StaffAttendance[] @relation("StaffAttendanceRecorder")
  bkkhReports  BkkhReport[] @relation("BkkhTeacher")
  homeroomClasses ClassRoom[] @relation("ClassRoomHomeroom")
  reviewedReportCards ReportCard[] @relation("ReportCardReviewer")
  notifications Notification[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([verifiedAt])
}

model StudentProfile {
  id            String         @id @default(uuid())
  name          String
  level         EducationLevel @default(SMP)
  studentNumber String         @unique
  // Cermin denormalisasi dari classRoom.name; dijaga sinkron saat santri ditempatkan.
  className     String
  classRoomId   String?
  classRoom     ClassRoom?     @relation(fields: [classRoomId], references: [id], onDelete: SetNull)
  phone         String?
  address       String?
  parentId      String?
  parent        User?          @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  enrollments   Enrollment[]
  attendanceRecords AttendanceRecord[]
  gradeRecords  GradeRecord[]
  reportCards   ReportCard[]
  administrations StudentAdministration[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([name])
  @@index([className])
  @@index([classRoomId])
  @@index([level])
  @@index([parentId])
}

// Kelas sebagai entitas tersendiri sehingga satu wali kelas memiliki satu kelas
// per tahun ajaran, lengkap dengan santri dan mata pelajarannya.
model ClassRoom {
  id                String           @id @default(uuid())
  name              String
  level             EducationLevel
  academicYear      String
  homeroomTeacherId String?
  homeroomTeacher   User?            @relation("ClassRoomHomeroom", fields: [homeroomTeacherId], references: [id], onDelete: SetNull)
  students          StudentProfile[]
  courses           Course[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([name, academicYear])
  @@index([homeroomTeacherId])
  @@index([level])
}

// Kelompok penilaian pada rapor, mis. "Nilai Ujian Tulis" atau "Penilaian Sikap
// dan Kedisiplinan". Nilai maksimal bawaan bisa ditimpa per mata pelajaran.
model AssessmentGroup {
  id              String              @id @default(uuid())
  name            String
  kind            AssessmentGroupKind @default(COURSE_SCORE)
  defaultMaxScore Int                 @default(7)
  sortOrder       Int                 @default(0)
  academicYear    String
  courses         Course[]
  criteria        BehaviorCriterion[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([name, academicYear])
  @@index([academicYear])
}

// Baris "Penilaian Sikap dan Kedisiplinan" pada rapor.
model BehaviorCriterion {
  id        String          @id @default(uuid())
  groupId   String
  group     AssessmentGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name      String
  maxScore  Int             @default(7)
  sortOrder Int             @default(0)

  @@unique([groupId, name])
  @@index([groupId])
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Course {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  description String
  level       EducationLevel @default(SMP)
  status      CourseStatus   @default(PUBLISHED)
  createdById String?
  createdBy   User?        @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  teacherId   String?
  teacher     User?        @relation("CourseTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  // Kelompok penilaian rapor (Ujian Tulis, Ekstrakurikuler, Ujian Lisan, ...).
  assessmentGroupId String?
  assessmentGroup   AssessmentGroup? @relation(fields: [assessmentGroupId], references: [id], onDelete: SetNull)
  classRoomId String?
  classRoom   ClassRoom?   @relation(fields: [classRoomId], references: [id], onDelete: SetNull)
  // Nilai maksimal rapor khusus mapel ini; null = ikut defaultMaxScore kelompok.
  reportMaxScore Int?
  enrollments Enrollment[]
  attendanceSessions AttendanceSession[]
  gradeItems GradeItem[]
  scheduleSlots ScheduleSlot[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  @@index([status])
  @@index([level])
  @@index([createdById])
  @@index([teacherId])
  @@index([assessmentGroupId])
  @@index([classRoomId])
}

model ScheduleSlot {
  id        String   @id @default(uuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  room      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([dayOfWeek])
}

model Enrollment {
  id          String           @id @default(uuid())
  studentId   String
  student     StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  updatedAt   DateTime         @updatedAt

  @@unique([studentId, courseId])
  @@index([courseId])
  @@index([status])
}

model AttendanceSession {
  id        String             @id @default(uuid())
  courseId  String
  course    Course             @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  heldAt    DateTime
  semester     Semester @default(GANJIL)
  academicYear String   @default("2026/2027")
  records   AttendanceRecord[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([courseId, heldAt])
  @@index([heldAt])
  @@index([createdAt])
  @@index([academicYear, semester])
  @@unique([courseId, title])
}

model AttendanceRecord {
  id                  String           @id @default(uuid())
  attendanceSessionId String
  attendanceSession   AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  studentId           String
  student             StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  status              AttendanceStatus @default(PRESENT)
  note                String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([attendanceSessionId, studentId])
  @@index([studentId])
  @@index([status])
}

model GradeItem {
  id          String        @id @default(uuid())
  courseId    String
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String?
  maxScore    Int           @default(100)
  // Bobot komponen (persen) terhadap nilai akhir mata pelajaran.
  weight      Int           @default(1)
  dueAt       DateTime?
  semester     Semester @default(GANJIL)
  academicYear String   @default("2026/2027")
  records     GradeRecord[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([courseId])
  @@index([dueAt])
  @@index([createdAt])
  @@index([academicYear, semester])
  @@unique([courseId, title])
}

model GradeRecord {
  id          String    @id @default(uuid())
  gradeItemId String
  gradeItem   GradeItem @relation(fields: [gradeItemId], references: [id], onDelete: Cascade)
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score       Int
  feedback    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([gradeItemId, studentId])
  @@index([studentId])
}

// Rapor per santri per periode. Nilai akhir di-snapshot saat dibuat;
// setelah PUBLISHED, isi rapor tidak berubah walau nilai sumber diedit.
model ReportCard {
  id           String           @id @default(uuid())
  studentId    String
  student      StudentProfile   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester     Semester
  academicYear String
  homeroomNote String?
  // Identitas santri di-snapshot saat rapor disusun agar cetak ulang rapor tahun
  // lalu tetap menampilkan kelas/nama saat itu, bukan kelas santri sekarang.
  // Null pada baris lama (sebelum kolom ini ada) — pembaca jatuh ke StudentProfile.
  studentNameSnapshot   String?
  studentNumberSnapshot String?
  classNameSnapshot     String?
  levelSnapshot         String?
  status       ReportCardStatus @default(DRAFT)
  publishedAt  DateTime?
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?            @relation("ReportCardReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  adminNote    String?
  // Rekap ketidakhadiran sesuai format rapor pondok.
  sickCount    Int              @default(0)
  excusedCount Int              @default(0)
  otherCount   Int              @default(0)
  createdById  String?
  createdBy    User?            @relation("ReportCardCreator", fields: [createdById], references: [id], onDelete: SetNull)
  entries      ReportCardEntry[]
  behaviorEntries ReportCardBehaviorEntry[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([studentId, semester, academicYear])
  @@index([status])
  @@index([academicYear, semester])
  @@index([reviewedById])
}

// Satu baris rapor per mata pelajaran. courseTitle & kelompok disimpan sebagai snapshot.
model ReportCardEntry {
  id           String     @id @default(uuid())
  reportCardId String
  reportCard   ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  courseId     String?
  courseTitle  String
  // Snapshot kelompok penilaian agar urutan rapor tetap walau master data berubah.
  groupName    String     @default("")
  groupSortOrder Int      @default(0)
  // finalScore = nilai mentah 0-100; scoreValue = nilai pada skala 0..maxScore
  // sesuai format rapor, scoreWords = terbilang, mis. "Tujuh".
  finalScore   Int
  maxScore     Int        @default(10)
  scoreValue   Int        @default(0)
  scoreWords   String     @default("")
  present      Int        @default(0)
  late         Int        @default(0)
  absent       Int        @default(0)
  excused      Int        @default(0)

  @@unique([reportCardId, courseTitle])
  @@index([courseId])
}

// Baris penilaian sikap & kedisiplinan pada rapor (snapshot dari BehaviorCriterion).
model ReportCardBehaviorEntry {
  id            String     @id @default(uuid())
  reportCardId  String
  reportCard    ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  criterionName String
  maxScore      Int        @default(7)
  scoreValue    Int        @default(0)
  sortOrder     Int        @default(0)

  @@unique([reportCardId, criterionName])
  @@index([reportCardId])
}

// Definisi checklist administrasi santri per periode; jadi syarat ACC rapor.
model AdministrationItem {
  id           String                  @id @default(uuid())
  name         String
  description  String?
  academicYear String
  semester     Semester
  sortOrder    Int                     @default(0)
  active       Boolean                 @default(true)
  records      StudentAdministration[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@unique([name, academicYear, semester])
  @@index([academicYear, semester])
}

// Pemenuhan checklist administrasi per santri.
model StudentAdministration {
  id          String             @id @default(uuid())
  studentId   String
  student     StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  itemId      String
  item        AdministrationItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fulfilled   Boolean            @default(false)
  note        String?
  updatedById String?
  updatedAt   DateTime           @updatedAt

  @@unique([studentId, itemId])
  @@index([itemId])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// Pendaftaran santri baru (PPDB). Saat diterima admin, dibuat akun orang tua + record santri.
model Admission {
  id               String          @id @default(uuid())
  // Kode pendaftaran berbeda dari NIS yang baru dibuat setelah calon diterima.
  registrationCode String          @unique
  childName        String
  level            EducationLevel
  gender           String?
  birthPlace       String?
  birthDate        DateTime?
  previousSchool   String?
  parentName       String
  parentPhone      String
  parentEmail      String
  address          String?
  note             String?
  status           AdmissionStatus @default(PENDING)
  reviewNote       String?
  reviewedAt       DateTime?
  reviewedById     String?
  createdStudentId String?
  createdParentId  String?
  submitterId       String?
  submitter         User?           @relation("AdmissionSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
  // Dokumen pendukung punya dua jalur: kolom URL di bawah dipakai bila wali santri
  // mengisi tautan, sedangkan model AdmissionDocument dipakai bila wali mengunggah
  // berkas. Tepat satu jalur terisi per dokumen (divalidasi di lib/admissions.ts).
  // (unggahan tersimpan di database). Dibiarkan agar data lama tidak hilang.
  familyCardUrl     String?
  birthCertificateUrl String?
  previousReportUrl String?
  photoUrl          String?
  paymentProofUrl   String?
  documents        AdmissionDocument[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status])
  @@index([level])
  @@index([submitterId])
  @@index([createdAt])
}

// Berkas unggahan pendaftaran, disimpan langsung sebagai bytes agar tidak
// bergantung pada storage eksternal.
model AdmissionDocument {
  id          String                @id @default(uuid())
  admissionId String
  admission   Admission             @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  kind        AdmissionDocumentKind
  filename    String
  mimeType    String
  size        Int
  data        Bytes
  createdAt   DateTime              @default(now())

  @@unique([admissionId, kind])
  @@index([admissionId])
}

// Absensi harian ustadz (pengajar & wali kelas).
model StaffAttendance {
  id           String           @id @default(uuid())
  teacherId    String
  teacher      User             @relation("StaffAttendanceTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  date         DateTime         @db.Date
  status       AttendanceStatus @default(PRESENT)
  note         String?
  recordedById String?
  recordedBy   User?            @relation("StaffAttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([teacherId, date])
  @@index([date])
  @@index([status])
}

// Pengaturan aplikasi berbentuk kunci-nilai. Dipakai untuk teks yang berubah
// mengikuti pergantian pengurus pondok (mis. nama penanda tangan rapor) sehingga
// tidak layak dikeraskan di kode. Kunci yang dipakai ada di lib/rapor.ts.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// BKKH: laporan kegiatan manual per ustadz dan tanggal. Rentang waktu mengikuti
// formulir BKKH pondok yang digunakan sebelum aplikasi dibuat.
model BkkhReport {
  id                 String   @id @default(uuid())
  teacherId          String
  teacher            User     @relation("BkkhTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  date               DateTime @db.Date
  activity03000715   String?  @db.Text
  activity07150900   String?  @db.Text
  activity09301200   String?  @db.Text
  activity12301430   String?  @db.Text
  activity15301700   String?  @db.Text
  activity18002100   String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([teacherId, date])
  @@index([date])
}
